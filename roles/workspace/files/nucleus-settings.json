{
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          { "type": "command", "command": "$HOME/.local/bin/nucleate hook-create", "timeout": 120 }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          { "type": "command", "command": "$HOME/.local/bin/nucleate hook-remove", "timeout": 120 }
        ]
      }
    ]
  }
}
