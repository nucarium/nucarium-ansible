#!/usr/bin/env bash
# Stops one agent server and returns only once it has gone. The unit
# agent-server@<name>.service runs this as its ExecStop.
#
# tmux starts each pane in a scope of its own (tmux-spawn-<id>.scope), outside
# the unit, so systemd neither waits for the server nor stops it. Without the
# wait, a restart starts the new server while the old one is still shutting
# down, and the new one exits at once.
set -euo pipefail

socket="agent-${1:?usage: agent-server-stop <name>}"

# The server exits by itself, by design, so there may be nothing to stop.
panes=$(tmux -L "$socket" list-panes -a -F '#{pane_pid}' 2>/dev/null) || exit 0

# The scope each pane runs in. Only tmux's own scopes: a pane inside this unit
# is stopped with it, and stopping the unit from here would wait for itself.
scopes=()
for pid in $panes; do
  unit=$(ps -o uunit= -p "$pid" 2>/dev/null | tr -d ' ') || continue
  case "$unit" in
    tmux-spawn-*.scope) scopes+=("$unit") ;;
  esac
done

# Stop the server as a person would in its terminal, with Ctrl-C, and give
# it time to go: Ctrl-C lets it unregister, a hang-up does not, and the
# folder then counts as served for several minutes, so the next server is
# refused. Then hang up on whatever is left, as closing its terminal would.
tmux -L "$socket" send-keys -t "$1" C-c 2>/dev/null || true
for _ in $(seq 30); do
  alive=0
  for pid in $panes; do
    if kill -0 "$pid" 2>/dev/null && pgrep -P "$pid" >/dev/null 2>&1; then
      alive=1
    fi
  done
  [ "$alive" = 1 ] || break
  sleep 1
done
tmux -L "$socket" kill-server 2>/dev/null || true

# Stopping a scope waits until everything in it has exited, the server's
# sessions included, and ends anything left after TimeoutStopSec.
if [ "${#scopes[@]}" -gt 0 ]; then
  systemctl --user stop "${scopes[@]}" 2>/dev/null || true
fi
