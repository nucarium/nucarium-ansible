#!/usr/bin/env bash
# Runs one agent server: Claude Code's Remote Control server, started in the
# nucleus so every session it spawns gets its own folder there.
#
# agent-server-<name>.service starts this inside tmux and starts it again
# when it exits, which the server does by design after about ten minutes
# without a connection. In a container environment, agent-env-<name>.service
# does the same inside the environment's container (AGENT_SERVER_RUNTIME is
# container there).
set -euo pipefail

: "${AGENT_SERVER_ROOT:?set by the service}"
: "${AGENT_SERVER_CAPACITY:?set by the service}"
: "${AGENT_SERVER_PREFIX:?set by the service}"

# In a container its unit sets PATH: the image's, then the box's own tools.
if [ "${AGENT_SERVER_RUNTIME:-host}" != container ]; then
  export PATH="$HOME/.local/bin:$HOME/.local/share/fnm/aliases/default/bin:/usr/local/go/bin:$HOME/go/bin:$PATH"
fi

# After a power cut the box boots faster than the router, and a user service
# cannot ask systemd to wait for the network.
until curl -s -o /dev/null --max-time 5 https://api.anthropic.com/; do
  sleep 5
done

# The environment's setup script runs first: at boot, and when the recipe
# changes it (nucarium-env-setup@<name>.service). That is a system unit and
# this server a user unit, which systemd cannot order after one, so the wait
# is here: while the script runs or waits to run, and no longer. A failed
# script does not hold the server back, and a server already running is never
# stopped for one. In a container the script is in the image already, and
# there is no systemd to ask.
setup_unit="nucarium-env-setup@${AGENT_SERVER_NAME:-}.service"
setup_pending() {
  [ "${AGENT_SERVER_RUNTIME:-host}" != container ] || return 1
  [ -n "${AGENT_SERVER_NAME:-}" ] || return 1
  [ "$(systemctl show --property=ActiveState --value "$setup_unit" 2> /dev/null)" = activating ] ||
    [ -n "$(systemctl list-jobs --no-legend "$setup_unit" 2> /dev/null)" ]
}
while setup_pending; do
  sleep 5
done

# In a container, what a login shell has: /etc/profile, which sources
# /etc/profile.d/*.sh, where a setup or start script puts PATH and service
# settings for every session, as in a cloud session. The start script, the
# server and every session it starts inherit it. An operator's file may fail
# or use an unset variable without stopping the server, and the unit's PATH,
# which holds the box's own tools, stays in it whatever a file does to PATH.
unit_path=$PATH
load_profile() {
  [ "${AGENT_SERVER_RUNTIME:-host}" = container ] && [ -r /etc/profile ] || return 0
  set +eu
  # shellcheck disable=SC1091 # the image's, not this repository's
  . /etc/profile
  set -eu
  case ":$PATH:" in
    *":$unit_path:"*) ;;
    *) PATH="$PATH:$unit_path" ;;
  esac
  export PATH
}
load_profile

# In a container, the environment's start script (start_script), as root, at
# each start of the container: a setup script runs once, when the image is
# built, so what it starts (a database server, say) is not running here
# until this starts it. Up to five minutes, its output in this pane; one
# that fails or runs too long does not hold the server back. The profile is
# read again after it, so that what it adds to /etc/profile.d counts too.
if [ "${AGENT_SERVER_RUNTIME:-host}" = container ] && [ -r "${AGENT_SERVER_START:-}" ]; then
  echo "Running the start script."
  start_status=0
  (cd /root && timeout --kill-after=10 300 bash "$AGENT_SERVER_START" < /dev/null) || start_status=$?
  if [ "$start_status" -ne 0 ]; then
    echo "The start script failed (exit code $start_status); the agent server starts anyway."
  fi
  load_profile
fi

# A repository added to the environment's list (its repos, else the box's)
# after the container's own nucleus was made is cloned here, inside the
# container: the host runs no git in this nucleus but nucleated's, which
# checks each repository first. With a GitHub identity of its own, every
# repository is cloned here, with the environment's own token: the host has
# none for them.
if [ "${AGENT_SERVER_RUNTIME:-host}" = container ] && [ -r "${AGENT_SERVER_REPOS:-}" ]; then
  while read -r url; do
    [ -n "$url" ] || continue
    repo=${url##*/}
    [ -e "${AGENT_SERVER_NUCLEUS:?set by the unit}/.repos/$repo" ] && continue
    nucleate clone "$url" > /dev/null || echo "Could not clone $url into this environment's nucleus; it is tried again at the next start."
  done < "$AGENT_SERVER_REPOS"
fi

# nucleate's MCP server, for the login in user scope, as the playbook
# registers it on the host: a container's login is not the host's to touch.
if [ "${AGENT_SERVER_RUNTIME:-host}" = container ]; then
  nucleate=$(command -v nucleate)
  if ! claude mcp get nucleate 2> /dev/null | grep -qF "$nucleate mcp"; then
    claude mcp remove --scope user nucleate > /dev/null 2>&1 || true
    claude mcp add --scope user nucleate -- "$nucleate" mcp
  fi
fi

# A container's login is signed in by hand, once, from inside the container
# (podman exec -it agent-env-<name> claude); until then the server waits
# rather than exit and be restarted over and over.
if [ "${AGENT_SERVER_RUNTIME:-host}" = container ] && ! claude auth status > /dev/null 2>&1; then
  echo "Not signed in to Claude. Sign in with: podman exec -it agent-env-${AGENT_SERVER_NAME:-<name>} claude"
  until claude auth status > /dev/null 2>&1; do
    sleep 10
  done
fi

cd "$AGENT_SERVER_ROOT"
# A server that went without unregistering (it crashed, or was stopped
# before it had gone) still counts as serving this folder for several
# minutes, and a new one exits at once with 69. Wait for that to lapse
# rather than exit, which would use up the unit's restarts. Anything else
# ends the script with the server's own status, as before.
deadline=$((SECONDS + 1200))
while :; do
  status=0
  claude remote-control \
    --spawn worktree \
    --no-create-session-in-dir \
    --no-chrome \
    --capacity "$AGENT_SERVER_CAPACITY" \
    --remote-control-session-name-prefix "$AGENT_SERVER_PREFIX" || status=$?
  if [ "$status" -ne 69 ] || [ "$SECONDS" -ge "$deadline" ]; then
    exit "$status"
  fi
  echo "Remote Control would not start (69, as while an earlier server of this folder has not lapsed). Trying again in 30 seconds."
  sleep 30
done
