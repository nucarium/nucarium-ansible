#!/usr/bin/env bash
# Runs one agent server: Claude Code's Remote Control server, started in the
# nucleus so every session it spawns gets its own folder there.
#
# agent-server-<name>.service starts this inside tmux and starts it again
# when it exits, which the server does by design after about ten minutes
# without a connection.
set -euo pipefail

: "${AGENT_SERVER_ROOT:?set by the service}"
: "${AGENT_SERVER_CAPACITY:?set by the service}"
: "${AGENT_SERVER_PREFIX:?set by the service}"

export PATH="$HOME/.local/bin:$HOME/.local/share/fnm/aliases/default/bin:/usr/local/go/bin:$HOME/go/bin:$PATH"

# After a power cut the box boots faster than the router, and a user service
# cannot ask systemd to wait for the network.
until curl -s -o /dev/null --max-time 5 https://api.anthropic.com/; do
  sleep 5
done

# The environment's setup script runs first: at boot, and when the recipe
# changes it (nucarium-env-setup@<name>.service). That is a system unit and
# this server a user unit, which systemd cannot order after one, so the wait
# is here: while the script runs or waits to run, and no longer. A failed
# script does not hold the server back, and a server already running is never
# stopped for one.
setup_unit="nucarium-env-setup@${AGENT_SERVER_NAME:-}.service"
setup_pending() {
  [ -n "${AGENT_SERVER_NAME:-}" ] || return 1
  [ "$(systemctl show --property=ActiveState --value "$setup_unit" 2> /dev/null)" = activating ] ||
    [ -n "$(systemctl list-jobs --no-legend "$setup_unit" 2> /dev/null)" ]
}
while setup_pending; do
  sleep 5
done

cd "$AGENT_SERVER_ROOT"
exec claude remote-control \
  --spawn worktree \
  --no-create-session-in-dir \
  --no-chrome \
  --capacity "$AGENT_SERVER_CAPACITY" \
  --remote-control-session-name-prefix "$AGENT_SERVER_PREFIX"
