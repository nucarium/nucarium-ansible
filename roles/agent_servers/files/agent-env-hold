#!/usr/bin/env bash
# The main process of a container environment's agent server container
# (agent-env-<name>.service), as tmux is the main process of the unit on the
# host: starts the agent server in a tmux session of its own, and lasts as
# long as that session does, so the container ends when the server exits by
# itself and its unit starts it again. Stopping the container hangs up on the
# server, as closing its terminal would. Look at it with:
#   podman exec -it agent-env-<name> tmux -L agent-<name> attach
set -euo pipefail

name="${AGENT_SERVER_NAME:?set by the unit}"
command="${AGENT_SERVER_COMMAND:?set by the unit}"
socket="agent-$name"

tmux -L "$socket" new-session -d -s "$name" "$command"
trap 'tmux -L "$socket" kill-server 2> /dev/null || true; exit 0' TERM INT HUP
while tmux -L "$socket" has-session -t "$name" 2> /dev/null; do
  sleep 2 &
  wait $! || true
done
