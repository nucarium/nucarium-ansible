#!/usr/bin/env bash
# Runs before agent-env-<name>.service starts the environment's container
# (its ExecStartPre), as the agent user:
#
#   agent-env-start <name> <nucleus> <file>
#
# Stops the start, with a message in the unit's log, when:
#
# - one of the files at the root of the environment's own nucleus that the
#   container gets read-only, so that no session plants instructions or
#   hooks there for later ones, is missing, a link, or not what it should
#   be: the folders .claude/ and .seeds/, and the files
#   .claude/settings.json, .mcp.json, AGENTS.md and CLAUDE.md
#   (nucarium_nucleus_protected in vars/runtime.yml). A container started
#   anyway could create the file, or a link in its place. The playbook makes
#   all of them; one that is wrong now was changed on the box since, and is
#   the operator's to look at.
# - the environment has no image yet: nucarium-env-setup@<name>.service
#   builds it, and starts this unit once it is there.
#
# Otherwise writes <file>, which the unit reads for the container's command
# line: a read-only mount, on top of the nucleus the container writes, of
# each bare repository's hooks folder, so that nothing in the container
# plants a hook a git run on the host might run. A repository added while
# the container runs has writable hooks until its next start. Only a folder
# whose name a repository can have is mounted, and only when neither it nor
# its hooks folder is a link: anything else would let a session choose what
# the next container mounts. The check comes a moment before podman mounts
# it, a window in which a link could still be put in its place.
set -euo pipefail

name="${1:?usage: agent-env-start <name> <nucleus> <file>}"
nucleus="${2:?usage: agent-env-start <name> <nucleus> <file>}"
out="${3:?usage: agent-env-start <name> <nucleus> <file>}"
case "$name" in -* | *[!a-z0-9-]*)
  echo "agent-env-start: not an environment name: $name" >&2
  exit 2
  ;;
esac

refuse() {
  echo "Environment $name's agent server does not start: $1 in the nucleus is $2, and must be $3, which the container gets read-only."
  echo "Put it back as it was (the playbook's --tags workspace makes a missing one again), then start agent-env-$name.service."
  exit 1
}
for want in d:.claude f:.claude/settings.json d:.seeds f:.mcp.json f:AGENTS.md f:CLAUDE.md; do
  kind=${want%%:*}
  label=${want#*:}
  path="$nucleus/$label"
  if [ "$kind" = d ]; then what="a folder"; else what="a file"; fi
  if [ -L "$path" ]; then
    refuse "$label" "a link" "$what"
  elif [ ! -e "$path" ]; then
    refuse "$label" "missing" "$what"
  elif { [ "$kind" = d ] && [ ! -d "$path" ]; } || { [ "$kind" = f ] && [ ! -f "$path" ]; }; then
    refuse "$label" "not $what" "$what"
  fi
done

image="localhost/nucarium-env-$name:current"
if ! podman image exists "$image"; then
  echo "Environment $name has no image yet ($image), so its agent server cannot start."
  echo "nucarium-env-setup@$name.service builds it and then starts this unit; to see how that went: sudo journalctl -u nucarium-env-setup@$name.service"
  exit 1
fi

# .repos and .worktrees must be the nucleus's own folders: the container
# gets each as a mount of its own, and a link there would choose which of the
# box's folders it gets (and, for .repos, which hooks folders the loop below
# mounts).
for own in .repos .worktrees; do
  if [ -L "$nucleus/$own" ]; then
    echo "Environment $name's agent server does not start: $own in the nucleus is a link, and must be a folder of its own." >&2
    exit 1
  elif [ ! -d "$nucleus/$own" ]; then
    echo "Environment $name's agent server does not start: $own in the nucleus is missing or not a folder." >&2
    exit 1
  fi
done
repos_real=$(realpath "$nucleus/.repos")

volumes=()
for repo in "$nucleus"/.repos/*.git; do
  [ -e "$repo" ] || continue
  base=${repo##*/}
  hooks="$repo/hooks"
  if ! [[ "$base" =~ ^[A-Za-z0-9._-]+\.git$ ]] || [ -L "$repo" ] || [ -L "$hooks" ] || [ ! -d "$hooks" ] ||
    [ "$(realpath "$hooks" 2> /dev/null)" != "$repos_real/$base/hooks" ]; then
    echo "agent-env-start: not mounting $hooks read-only: not a repository's own hooks folder" >&2
    continue
  fi
  volumes+=("--volume=$hooks:$hooks:ro")
done

tmp=$(mktemp "$out.XXXXXX")
printf 'NUCARIUM_HOOK_VOLUMES=%s\n' "${volumes[*]}" > "$tmp"
mv -f "$tmp" "$out"
