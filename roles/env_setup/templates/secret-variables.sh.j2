# Environment {{ env.name }}'s secret variables, from secret_variables in
# group_vars/all.yml and your file of environment secrets. Written by the
# Nucarium box recipe; the next run rewrites this file.
# {{ nucarium_lib_dir }}/session-env.sh adds them to every new session of
# the environment.
{% for name in env_secret_variables %}
export {{ name }}={{ nucarium_environment_secrets[env.name][name] | quote }}
{% endfor %}
