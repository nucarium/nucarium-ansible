# Environment {{ env.name }}'s network, as its setup script sees it when its
# image is built: everything outside its own network goes through its proxy,
# which allows what network: {{ env_network }} allows. Written by the Nucarium
# box recipe; the next run rewrites this file.
{% for name, value in env_runtime_proxy_env.items() %}
{{ name }}={{ value | quote }}
{% endfor %}
