#!/usr/bin/env bash
case "${1:-}" in
  get)
    [ "${2:-}" = "app.terraform.io" ] || { echo '{}'; exit 0; }
    token=$(cat /run/agent-tokens/hcp) || { echo "agentvault: no token from the broker" >&2; exit 1; }
    jq -nc --arg token "$token" '{token: $token}' ;;
  store) cat >/dev/null; echo "agentvault: tokens are managed by the broker" >&2; exit 1 ;;
  forget) echo "agentvault: tokens are managed by the broker" >&2; exit 1 ;;
  *) echo "agentvault: unsupported verb ${1:-}" >&2; exit 1 ;;
esac
