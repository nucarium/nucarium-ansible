{
  "autoUpdatesChannel": "stable",
{% if env_runtime == 'container' %}
  "sandbox": {
    "enabled": false
  },
{% else %}
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["podman", "docker"],
    "filesystem": {
      "allowWrite": {{ claude_sandbox_allow_write | to_json }},
      "denyWrite": {{ (claude_sandbox_deny_in_allowed + claude_sandbox_deny_nucleus + claude_sandbox_deny_write) | to_json }},
      "denyRead": {{ claude_sandbox_deny_read | to_json }}
    },
    "network": {{ claude_sandbox_network | to_json }}
  },
{% endif %}
  "permissions": {
    "allow": [
      "mcp__nucleate"
    ],
    "deny": [
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform force-unlock *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "{{ claude_session_env }} {{ env.name }}", "timeout": 10 },
          { "type": "command", "command": "{{ claude_nucleated_hook }} SessionStart --env {{ env.name }}", "async": true, "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "{{ claude_nucleated_hook }} UserPromptSubmit --env {{ env.name }}", "async": true, "timeout": 5 }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "{{ claude_nucleated_notifications | join('|') }}",
        "hooks": [
          { "type": "command", "command": "{{ claude_nucleated_hook }} Notification --env {{ env.name }}", "async": true, "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "{{ claude_nucleated_hook }} PostToolUse --env {{ env.name }}", "async": true, "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "{{ claude_nucleated_hook }} Stop --env {{ env.name }}", "async": true, "timeout": 5 }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          { "type": "command", "command": "{{ claude_nucleated_hook }} StopFailure --env {{ env.name }}", "async": true, "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "{{ claude_nucleated_hook }} SessionEnd --env {{ env.name }}", "timeout": 5 }
        ]
      }
    ]
  }
}
