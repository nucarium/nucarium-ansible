#!/usr/bin/env bash
set -euo pipefail
umask 027
{% if hcp_mode == 'vault' %}
OP_SERVICE_ACCOUNT_TOKEN=$(cat /etc/agent-broker/vault-read-token)
export OP_SERVICE_ACCOUNT_TOKEN
token=$(op read '{{ secret_refs.hcp_token }}')
{% else %}
token=$(cat /etc/agent-broker/hcp-token)
{% endif %}
printf '%s' "$token" > /run/agent-tokens/hcp.tmp
mv /run/agent-tokens/hcp.tmp /run/agent-tokens/hcp
