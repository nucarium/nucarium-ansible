{% for env in environments %}

# Environment {{ env.name }}: one Claude login and its agent server, over the
# nucleus{{ ', in its own container' if env.runtime | default('host', true) == 'container' else '' }}.
[[environment]]
name = "{{ env.name }}"
root = "{{ nucleus_root }}"
unit = "{{ ('agent-env-' ~ env.name ~ '.service') if env.runtime | default('host', true) == 'container' else ('agent-server@' ~ env.name ~ '.service') }}"
agent = "claude-code"
config_dir = "{{ env.config_dir | default(agent_home ~ '/.claude') }}"
{% endfor %}
