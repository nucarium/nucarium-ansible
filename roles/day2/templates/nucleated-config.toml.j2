# nucleated's configuration. Written by the Nucarium box recipe from
# group_vars/all.yml; the next run of the playbook rewrites this file, so
# change the playbook's settings instead. The daemon picks up a change by
# itself.

# The name suggested for this box at `nucleate login`.
machine = "{{ inventory_hostname }}"

{% if watch_target == 'hosted' %}
# Report to Nucarium Watch once the box is signed in (`nucleate login`).
# Watch sees which agent is doing what, where and since when, never what it
# was told or what it wrote.
target = "hosted"
{% else %}
# Report nowhere, signed in or not. `nucleated status` shows the same view on
# the box.
target = "none"
{% endif %}
{% for env in environments %}

# Environment {{ env.name }}: one Claude login and its agent server, over the
# nucleus.
[[environment]]
name = "{{ env.name }}"
root = "{{ nucleus_root }}"
unit = "agent-server@{{ env.name }}.service"
agent = "claude-code"
config_dir = "{{ env.config_dir | default(agent_home ~ '/.claude') }}"
{% endfor %}
