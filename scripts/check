#!/bin/sh
# Every check this recipe has, none of which needs a box. The Build workflow
# runs this same script.
#
#   python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt
#   PATH="$PWD/.venv/bin:$PATH" scripts/check
set -eu
cd "$(dirname "$0")/.."

# Every shell script in the recipe, this one included.
shell_files="
  scripts/check
  roles/agent_servers/files/agent-server
  roles/agent_servers/files/agent-server-stop
  roles/agent_servers/files/agent-server-runtime
  roles/agent_servers/files/agent-env-start
  roles/agent_servers/files/agent-env-hold
  roles/claude/files/session-env.sh
  roles/claude/files/terraform-credentials-agentvault
  roles/day2/files/agent-gc
  roles/env_setup/files/nucarium-env-setup
  roles/env_runtime/files/build/nucarium-env-build
"

echo "== syntax"
ansible-playbook --syntax-check site.yml autoinstall.yml tests/render.yml tests/proxy.yml

echo "== ansible-lint"
ansible-lint

echo "== yamllint"
yamllint .

echo "== dry runs read only what check mode really ran"
scripts/check-mode-probes

echo "== shellcheck"
# shellcheck disable=SC2086  # the list is split into file names on purpose
shellcheck $shell_files

echo "== render the templates from the example settings, in four shapes"
ansible-playbook tests/render.yml
ansible-playbook tests/render.yml -e @tests/two-logins.yml
ansible-playbook tests/render.yml -e @tests/three-networks.yml
ansible-playbook tests/render.yml -e @tests/own-identities.yml
# The same, with the environments' secrets inside a whole secrets given
# with -e, as some operators give every secret.
ansible-playbook tests/render.yml -e @tests/own-identities.yml -e '{"environment_secrets": {},
  "secrets": {"npm_token": "render-only", "environments": {"acme": {"GITHUB_TOKEN": "a", "TF_TOKEN": "b", "NODE_AUTH_TOKEN": "c"},
  "tools": {"API_KEY": "d"}, "docs": {"NODE_AUTH_TOKEN": "e"}}}}'

echo "== logins and setups render the same files as their environments written by hand"
ansible-playbook tests/render.yml -e @tests/logins-setups.yml -e @tests/logins-setups-expected.yml
rm -rf out/render-pairs && cp -R out/render out/render-pairs
ansible-playbook tests/render.yml -e @tests/logins-setups-by-hand.yml -e @tests/logins-setups-expected.yml
diff -r out/render-pairs out/render
echo "the same files"
# With the environments: block deleted, as the settings file says to: a
# copy of the settings without it, beside an inventory of its own (-e cannot
# remove a variable, and would outrank the environments made from setups).
noenv=out/render-noenv
rm -rf "$noenv" && mkdir -p "$noenv/group_vars"
cp inventory.ini "$noenv/"
awk '/^environments:$/ {skip = 1; next} skip && /^  / {next} {skip = 0; print}' group_vars/all.yml > "$noenv/group_vars/all.yml"
if grep -q '^environments:' "$noenv/group_vars/all.yml"; then echo "environments is still in $noenv"; exit 1; fi
ansible-playbook -i "$noenv/inventory.ini" tests/render.yml -e @tests/logins-setups.yml -e @tests/logins-setups-expected.yml > /dev/null
echo "and with no environments block"
# A run of one part of the playbook makes the same environments.
ansible-playbook site.yml --list-tasks --tags claude,env_setup | grep -q 'Make one environment for each setup a login joins'
echo "a run with --tags makes them too"

echo "== each architecture gets its own nucleate archive, checked against its own pin"
for machine in x86_64 aarch64; do
  ansible-playbook tests/render.yml -e nucarium_machine=$machine > /dev/null
  setting=nucleate_sha256
  [ $machine = aarch64 ] && setting=nucleate_sha256_aarch64
  pinned=$(sed -n "s/^$setting: \"\(.*\)\"\$/\1/p" group_vars/all.yml)
  grep -qx "nucleate_url: .*/nucleate-v[^/]*-$machine-unknown-linux-musl[.]tar[.]gz" out/render/derived.txt
  grep -qx "nucleate_sha256: $pinned" out/render/derived.txt
  echo "$machine: its archive, and $setting"
done

echo "== render the container environments' networks and proxies"
ansible-playbook tests/proxy.yml

echo "== the proxy's decisions and agent-env-start's refusals"
python3 -m unittest discover -s tests -p 'test_*.py'

echo "== refuse environments the recipe cannot set up"
# Each must stop the playbook before anything is rendered, with a message
# that says what is wrong. A third argument is the nucleate_version to try
# it with, 0.7.0 when there is none.
refuse() {
  if out=$(ansible-playbook tests/render.yml -e "{\"environments\": [$2]}" -e "nucleate_version=${3:-0.7.0}" 2>&1); then
    echo "Accepted, but must be refused: $2"
    exit 1
  fi
  case "$out" in
    *"$1"*) echo "refused: $2" ;;
    *)
      printf '%s\n' "$out"
      echo "Refused, but without saying: $1"
      exit 1
      ;;
  esac
}
refuse 'runtime is "docker", and must be host or container' '{"name": "main", "runtime": "docker"}'
refuse 'network is "open", and must be none, limited or full' '{"name": "main", "network": "open"}'
refuse 'runtime is container, which needs nucleate 0.7.0 or later, and nucleate_version is 0.6.0' '{"name": "second", "runtime": "container", "config_dir": "/home/agent/.claude-second"}' 0.6.0
refuse 'runtime is container, whose config_dir must be a folder of its own named .claude-<something>' '{"name": "second", "runtime": "container", "config_dir": "/home/agent/logins/second"}'
refuse 'runtime is container, and its config_dir /home/agent/.claude-two is also another environment' '{"name": "one", "runtime": "container", "config_dir": "/home/agent/.claude-two"}, {"name": "two", "config_dir": "/home/agent/.claude-two"}'
refuse 'runtime is container, which needs a config_dir of its own, such as /home/agent/.claude-main: the first login (~/.claude) stays on the host' '{"name": "main", "runtime": "container"}'
refuse 'runtime is container, which needs a config_dir of its own' '{"name": "second", "runtime": "container", "config_dir": "/home/agent/.claude/"}'
refuse 'config_dir is /home/agent/.claude-was/, and must be written plainly' '{"name": "main", "config_dir": "/home/agent/.claude-was/"}'
refuse 'config_dir is /home/agent//.claude-was, and must be written plainly' '{"name": "main", "config_dir": "/home/agent//.claude-was"}'
refuse 'config_dir is /home/agent/./.claude-was, and must be written plainly' '{"name": "main", "config_dir": "/home/agent/./.claude-was"}'
refuse 'config_dir is /home/agent/x/../.claude-was, and must be written plainly' '{"name": "main", "config_dir": "/home/agent/x/../.claude-was"}'
refuse 'keys the recipe does not know: netwrok' '{"name": "main", "netwrok": "full"}'
refuse 'variables is a set of NAME: value lines' '{"name": "main", "variables": ["NODE_ENV=test"]}'
refuse 'not shell variable names (letters, digits and _, not starting with a digit): 1ST, NODE-ENV' '{"name": "main", "variables": {"OK": "1", "1ST": "x", "NODE-ENV": "test"}}'
refuse 'variables has values that are not quoted text: DEBUG, EMPTY, MODE, VERSION' '{"name": "main", "variables": {"DEBUG": true, "EMPTY": null, "NAME": "x", "MODE": 493, "VERSION": 3.10}}'
refuse 'allowed_hosts adds hosts to limited only, and network is full' '{"name": "main", "network": "full", "allowed_hosts": ["api.example.com"]}'
refuse 'allowed_hosts allows every host with *: to allow every host, set network: full' '{"name": "main", "allowed_hosts": ["*"]}'
refuse 'allowed_hosts allows every host with *:443' '{"name": "main", "allowed_hosts": ["api.example.com", "*:443"]}'
refuse 'allowed_hosts has entries that are not a host' '{"name": "main", "allowed_hosts": ["https://api.example.com/"]}'
refuse 'allowed_hosts is a list of hosts' '{"name": "main", "allowed_hosts": "api.example.com"}'
refuse 'setup_script is the script itself, as text' '{"name": "main", "setup_script": ["apt-get update"]}'
# shellcheck disable=SC2016  # the ${#x} is the script's, not this one's
refuse 'environment main: setup_script has {{, {% or {# in it' '{"name": "main", "setup_script": "n=${#x}"}'
refuse "environment main: variables has {{, {% or {# in it, which Ansible reads as a template (see the error above). Write !unsafe" '{"name": "main", "variables": {"FORMAT": "{{.Names}}"}}'

# What only a container environment may have: its own repositories, secret
# variables, GitHub identity and start script.
box='"runtime": "container", "config_dir": "/home/agent/.claude-acme"'
refuse 'repos needs runtime: container, and runtime is host' '{"name": "main", "repos": ["acme/web"]}'
refuse 'secret_variables needs runtime: container, and runtime is host' '{"name": "main", "secret_variables": ["TF_TOKEN"]}'
refuse 'github needs runtime: container, and runtime is host' '{"name": "main", "github": {"name": "Acme Agent", "email": "agent@example.com"}}'
refuse 'start_script needs runtime: container, and runtime is host' '{"name": "main", "start_script": "service postgresql start"}'
refuse 'github needs GITHUB_TOKEN in secret_variables' "{\"name\": \"acme\", $box, \"secret_variables\": [\"TF_TOKEN\"], \"github\": {\"name\": \"Acme Agent\", \"email\": \"agent@example.com\"}}"
refuse "github is the environment's Git identity, name: and email:" "{\"name\": \"acme\", $box, \"secret_variables\": [\"GITHUB_TOKEN\"], \"github\": {\"name\": \"Acme Agent\"}}"
refuse 'secret_variables has names that are not shell variable names (letters, digits and _, not starting with a digit): TF-TOKEN' "{\"name\": \"acme\", $box, \"secret_variables\": [\"TF-TOKEN\"]}"
refuse 'secret_variables has names that are also in variables: TF_TOKEN' "{\"name\": \"acme\", $box, \"variables\": {\"TF_TOKEN\": \"x\"}, \"secret_variables\": [\"TF_TOKEN\"]}"
refuse 'secret_variables is a list of variable names' "{\"name\": \"acme\", $box, \"secret_variables\": \"TF_TOKEN\"}"
refuse 'secret_variables names a variable more than once, or two whose names differ only in case: tf_token' "{\"name\": \"acme\", $box, \"secret_variables\": [\"TF_TOKEN\", \"tf_token\"]}"
refuse 'secret_variables has names the container sets itself: PATH' "{\"name\": \"acme\", $box, \"secret_variables\": [\"PATH\"]}"
refuse 'repos has entries that are not a repository (a name, or owner/name): https://github.com/acme/web' "{\"name\": \"acme\", $box, \"repos\": [\"https://github.com/acme/web\"]}"
refuse 'repos has more than one repository named web, which would share one clone' "{\"name\": \"acme\", $box, \"repos\": [\"web\", \"acme/web\"]}"
refuse 'start_script is the script itself, as text' "{\"name\": \"acme\", $box, \"start_script\": [\"service postgresql start\"]}"
refuse 'secret_variables names GITHUB_TOKEN, which only an environment with github may have' "{\"name\": \"acme\", $box, \"secret_variables\": [\"GITHUB_TOKEN\"]}"
refuse 'secret_variables names GH_TOKEN, which only an environment with github may have' "{\"name\": \"acme\", $box, \"secret_variables\": [\"GH_TOKEN\"]}"
# Sessions on the host run podman outside their sandbox, as the owner of
# every container's secrets.
refuse 'environment acme has github or secret_variables, which need every environment on the box in a container (runtime: container), and main is on the host: sessions on the host run podman outside their sandbox' "{\"name\": \"main\"}, {\"name\": \"acme\", $box, \"secret_variables\": [\"TF_TOKEN\"]}"
refuse 'and main is on the host' "{\"name\": \"main\"}, {\"name\": \"acme\", $box, \"secret_variables\": [\"GITHUB_TOKEN\"], \"github\": {\"name\": \"Acme Agent\", \"email\": \"agent@example.com\"}}"
refuse 'would all be stored as nucarium-env-a-b-c' '{"name": "a-b", "runtime": "container", "config_dir": "/home/agent/.claude-ab", "secret_variables": ["C"]}, {"name": "a", "runtime": "container", "config_dir": "/home/agent/.claude-a", "secret_variables": ["B_C"]}'
refuse 'environment acme: secret_variables lists TF_TOKEN, and environment_secrets.acme.TF_TOKEN has no value' "{\"name\": \"acme\", $box, \"secret_variables\": [\"TF_TOKEN\"]}"
# shellcheck disable=SC2016  # the ${#x} is the script's, not this one's
refuse 'environment acme: start_script has {{, {% or {# in it' "{\"name\": \"acme\", $box, \"start_script\": \"n=\${#x}\"}"

# Logins and setups. Each argument after the message is a JSON object of
# settings, given with -e; environments stays the shipped one unless it
# names another.
refuse_setups() {
  if out=$(ansible-playbook tests/render.yml -e "$2" 2>&1); then
    echo "Accepted, but must be refused: $2"
    exit 1
  fi
  case "$out" in
    *"$1"*) echo "refused: $2" ;;
    *) printf '%s\n' "$out"; echo "Refused, but without saying: $1"; exit 1 ;;
  esac
}
alice='{"name": "alice", "setups": ["acme"]}'
acme='{"name": "acme", "runtime": "container"}'
refuse_setups 'logins needs setups beside it' "{\"logins\": [$alice]}"
refuse_setups 'setups needs logins beside it' "{\"setups\": [$acme]}"
refuse_setups 'environments is set beside logins and setups, which take its place: delete the environments: block' "{\"setups\": [$acme], \"logins\": [$alice], \"environments\": [{\"name\": \"main\"}]}"
refuse_setups 'login alice: setups lists tools, which is not a setup' "{\"setups\": [$acme], \"logins\": [{\"name\": \"alice\", \"setups\": [\"acme\", \"tools\"]}]}"
refuse_setups 'login alice: setups lists acme more than once' "{\"setups\": [$acme], \"logins\": [{\"name\": \"alice\", \"setups\": [\"acme\", \"acme\"]}]}"
refuse_setups 'login alice: setups is a list of the setups it joins, one per line, with at least one' "{\"setups\": [$acme], \"logins\": [{\"name\": \"alice\", \"setups\": []}]}"
refuse_setups 'setup Acme: name is a short label of lower-case letters, digits and hyphens' "{\"setups\": [{\"name\": \"Acme\"}], \"logins\": [{\"name\": \"alice\", \"setups\": [\"Acme\"]}]}"
refuse_setups 'more than one setup is named acme' "{\"setups\": [$acme, $acme], \"logins\": [$alice]}"
refuse_setups 'more than one login is named alice' "{\"setups\": [$acme], \"logins\": [$alice, $alice]}"
refuse_setups 'setup a-b with login c and setup a with login b-c would both be environment a-b-c: rename a setup or a login' '{"setups": [{"name": "a-b"}, {"name": "a"}], "logins": [{"name": "c", "setups": ["a-b"]}, {"name": "b-c", "setups": ["a"]}]}'
refuse_setups 'setup acme: it has keys a setup does not take: capacity, config_dir' "{\"setups\": [{\"name\": \"acme\", \"capacity\": 4, \"config_dir\": \"/home/agent/.claude-x\"}], \"logins\": [$alice]}"
refuse_setups 'login alice: it has keys a login does not take: runtime' "{\"setups\": [$acme], \"logins\": [{\"name\": \"alice\", \"runtime\": \"container\", \"setups\": [\"acme\"]}]}"
# shellcheck disable=SC2016  # the ${#x} is the script's, not this one's
refuse_setups 'setup acme: setup_script has {{, {% or {# in it' "{\"setups\": [{\"name\": \"acme\", \"setup_script\": \"n=\${#x}\"}], \"logins\": [$alice]}"
refuse_setups 'its name is 49 characters long, and may be at most 48: shorten the setup' "{\"setups\": [{\"name\": \"a-setup-with-a-rather-long-name-indeed\"}], \"logins\": [{\"name\": \"alice-abcd\", \"setups\": [\"a-setup-with-a-rather-long-name-indeed\"]}]}"
refuse_setups 'setup acme, login alice (environment acme-alice): secret_variables needs runtime: container, and runtime is host; github needs runtime: container' "{\"setups\": [{\"name\": \"acme\", \"github\": {\"name\": \"Acme Agent\", \"email\": \"agent@example.com\"}, \"secret_variables\": [\"GITHUB_TOKEN\"]}], \"logins\": [$alice]}"
refuse_setups 'setup acme has github or secret_variables, which need every setup on the box in a container (runtime: container), and plain is on the host' "{\"setups\": [{\"name\": \"acme\", \"runtime\": \"container\", \"secret_variables\": [\"TF_TOKEN\"]}, {\"name\": \"plain\"}], \"logins\": [{\"name\": \"alice\", \"setups\": [\"acme\", \"plain\"]}], \"environment_secrets\": {\"acme-alice\": {\"TF_TOKEN\": \"x\"}}}"
# The keys tasks/expand-setups.yml adds are never written by hand.
refuse 'keys the recipe does not know: setup' '{"name": "main", "setup": "acme"}'
refuse 'its name is 50 characters long, and may be at most 48' '{"name": "an-environment-whose-name-is-far-too-long-to-fit-x"}'

# A login a container environment has used is never used on the host again.
logins=out/render-logins
rm -rf "$logins" && mkdir -p "$logins"
was=$(python3 -c 'import hashlib, sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest())' /home/agent/.claude-was)
echo /home/agent/.claude-was > "$logins/$was"
if out=$(ansible-playbook tests/render.yml -e '{"environments": [{"name": "was", "config_dir": "/home/agent/.claude-was"}]}' \
  -e "nucarium_container_logins_dir=$PWD/$logins" 2>&1); then
  echo "Accepted, but must be refused: a container login on the host"
  exit 1
fi
case "$out" in
  *"config_dir /home/agent/.claude-was has been a container environment's login"*) echo "refused: a container login on the host" ;;
  *) printf '%s\n' "$out"; echo "Refused, but without saying why: a container login on the host"; exit 1 ;;
esac
refuse '(/home/agent), and is /home/agent/logins/.claude-second' '{"name": "second", "runtime": "container", "config_dir": "/home/agent/logins/.claude-second"}'

# An environment that has had a GitHub identity of its own: no environment
# without one takes its name or login, and no environment runs on the host
# beside what it left, even once it is gone from the settings.
github_envs=out/render-github-envs
rm -rf "$github_envs" && mkdir -p "$github_envs"
echo '{"name": "acme", "nucleus": "/home/agent/workspace-acme", "config_dir": "/home/agent/.claude-acme"}' > "$github_envs/acme"
refuse_recorded() {
  if out=$(ansible-playbook tests/render.yml -e "{\"environments\": [$2]}" -e "nucarium_github_envs_dir=$PWD/$github_envs" 2>&1); then
    echo "Accepted, but must be refused: $2"
    exit 1
  fi
  case "$out" in
    *"$1"*) echo "refused: $2, after a GitHub identity of its own" ;;
    *) printf '%s\n' "$out"; echo "Refused, but without saying: $1"; exit 1 ;;
  esac
}
refuse_recorded "environment acme: its name was a container environment's with a GitHub identity of its own" '{"name": "acme", "config_dir": "/home/agent/.claude-acme"}'
refuse_recorded "environment other: its config_dir /home/agent/.claude-acme was a container environment's" '{"name": "other", "runtime": "container", "config_dir": "/home/agent/.claude-acme"}'
refuse_recorded "runs on the host, and this box has had container environments with a GitHub identity of their own (acme)" '{"name": "main"}'
# The same for the environment of a login and a setup, whose name and
# config_dir are worked out: the way out is renaming one of them.
echo '{"name": "acme-alice", "nucleus": "/home/agent/workspace-acme-alice", "config_dir": "/home/agent/.claude-acme-alice"}' > "$github_envs/acme-alice"
if out=$(ansible-playbook tests/render.yml -e '{"setups": [{"name": "acme", "runtime": "container"}], "logins": [{"name": "alice", "setups": ["acme"]}]}' \
  -e "nucarium_github_envs_dir=$PWD/$github_envs" 2>&1); then
  echo "Accepted, but must be refused: a pair taking a recorded name"
  exit 1
fi
case "$out" in
  *"setup acme, login alice (environment acme-alice): its name was a container environment's with a GitHub identity of its own"*"give setup acme its github back, or rename the setup or the login"*)
    echo "refused: a pair, after a GitHub identity of its own" ;;
  *) printf '%s\n' "$out"; echo "Refused, but without naming the setup and login"; exit 1 ;;
esac

echo "== all checks passed"
